# =========================================================================
# KURUKSHETRA PS20: AGENTIC DISASTER RELIEF SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or actual private keys to Git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Supabase Database & Auth Configuration
# -------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_secret_here

# -------------------------------------------------------------------------
# 2. AI Model Provider Keys (Server-side Only)
# -------------------------------------------------------------------------
# Groq API: Used by "Sentinel Agent" for <300ms Llama 3 triage & severity scoring
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini API: Used by "Strategist Agent" for complex multi-depot allocation
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# -------------------------------------------------------------------------
# 3. Application & Deployment Settings
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
